   "id": "34108385",
   "metadata": {},
   "source": [
    "Monte Carlo Investment Simulation (TSLA / BYD / Toyota)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "44cdfbd3",
   "metadata": {},
   "outputs": [],
   "source": [
    "stocks = [\"TSLA\",\"BYDDY\",\"TM\"]\n",
    "prices = yf.download(stocks, start=\"2015-01-01\")[\"Close\"]\n",
    "returns = prices.pct_change().dropna()\n",
    "\n",
    "simulations = 1000\n",
    "days = 252\n",
    "\n",
    "results = {}\n",
    "\n",
    "for stock in stocks:\n",
    "    mu = returns[stock].mean()\n",
    "    sigma = returns[stock].std()\n",
    "    \n",
    "    sim = np.zeros(simulations)\n",
    "    for i in range(simulations):\n",
    "        sim[i] = np.prod(1 + np.random.normal(mu, sigma, days))\n",
    "    results[stock] = sim\n",
    "\n",
    "pd.DataFrame(results).describe()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "3d2896d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "px.histogram(\n",
    "    pd.DataFrame(results),\n",
    "    barmode=\"overlay\",\n",
    "    title=\"Monte Carlo Simulation – 1Y Investment Returns\"\n",
    ").show()\n"
   ]
