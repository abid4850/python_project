    "import os\n",
    "import requests\n",
    "import zipfile\n",
    "\n",
    "URL = \"https://cricsheet.org/downloads/t20s_yaml.zip\"\n",
    "zip_path = \"t20s_yaml.zip\"\n",
    "extract_path = \"cricsheet_t20s\"\n",
    "\n",
    "print(\"⬇️ Downloading Cricsheet T20 dataset...\")\n",
    "\n",
    "headers = {\n",
    "    \"User-Agent\": \"Mozilla/5.0\"\n",
    "}\n",
    "\n",
    "r = requests.get(URL, headers=headers, stream=True)\n",
    "print(\"Status code:\", r.status_code)\n",
    "\n",
    "if r.status_code != 200:\n",
    "    raise Exception(\"❌ Failed to download file. Status code not 200.\")\n",
    "\n",
    "# Save to disk first\n",
    "with open(zip_path, \"wb\") as f:\n",
    "    for chunk in r.iter_content(chunk_size=8192):\n",
    "        if chunk:\n",
    "            f.write(chunk)\n",
    "\n",
    "print(\"💾 Downloaded file saved as:\", zip_path)\n",
    "\n",
    "# Check if it's a valid zip\n",
    "import pandas as pd\n",
    "\n",
    "ball_df = pd.read_csv(\"ball_by_ball.csv\")\n",
    "match_df = pd.read_csv(\"match_info.csv\")\n",
    "\n",
    "# Merge on match_id\n",
    "combined = pd.merge(ball_df, match_df, on=\"match_id\", how=\"left\")\n",
    "\n",
    "# Save\n",
    "combined.to_csv(\"cricsheet_all_matches_combined.csv\", index=False)\n",
    "combined.to_excel(\"cricsheet_all_matches_combined.xlsx\", index=False)\n",
    "\n",
    "\n",
    "print(\"✅ Extraction complete! Files are in:\", extract_path)\n"
   ]
